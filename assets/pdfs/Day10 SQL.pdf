6 0 obj
<<
/Title (SELECT c.customer_name, CAST\(SUM\(i.total_price\) AS DECIMAL\(9,6\)\) AS total FROM customer c INNER JOIN invoice i ON c.id = i.customer_id GROUP BY c.customer_name HAVING SUM\(i.total_price\) < 0.25 * \(SELECT AVG\(total_price\) FROM invoice\) ORDER BY total DESC;)
